DATABASE_URL=sqlite+aiosqlite:///./familyconnect.db
SECRET_KEY=dev-secret-change-in-prod
DEBUG=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
APP_NAME=FamilyConnect API

# AI Provider (set to "openai" or "claude" when ready, default "mock")
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=          # optional — custom endpoint (e.g. http://localhost:11434/v1 for Ollama)
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
