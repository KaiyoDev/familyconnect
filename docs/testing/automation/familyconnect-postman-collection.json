{
  "info": {
    "name": "FamilyConnect API Tests",
    "description": "Postman collection for automated API testing of FamilyConnect\n\n## Usage\n1. Import this collection into Postman\n2. Set environment variables:\n   - base_url: http://localhost:8000/api/v1\n   - admin_token: (get from login)\n   - owner_token: (get from login)\n   - member_token: (get from login)\n3. Run collection runner\n\n## Test Coverage\n- Module 1: User & Security (44 tests)\n- Module 2: Family & Genealogy (42 tests)\n- Module 3: Community (27 tests)\n- Module 4: Events (20 tests)\n- Module 5: Family Directory (11 tests)\n- Module 6: Family Heritage (15 tests)\n- Module 7: AI Services (15 tests)\n- Module 8: Dashboard (11 tests)\n- Module 9: Administration (21 tests)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "familyconnect"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "owner_token",
      "value": ""
    },
    {
      "key": "member_token",
      "value": ""
    },
    {
      "key": "family_id",
      "value": "family-A"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. User & Security",
      "item": [
        {
          "name": "US-01: Register - Positive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has userId', function() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('userId');",
                  "});",
                  "pm.test('Email is sent to pending activation', function() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('PENDING_ACTIVATION');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Nguyễn Văn Test\",\n    \"email\": \"test_{{ $timestamp }}@example.com\",\n    \"password\": \"Abc12345\",\n    \"password_confirm\": \"Abc12345\",\n    \"agree_terms\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "US-02: Login - Positive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has access token', function() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json.accessToken).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
                  "});",
                  "pm.test('Has refresh token', function() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('refreshToken');",
                  "});",
                  "pm.test('Response time < 3000ms', function() {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "// Save tokens to environment",
                  "const json = pm.response.json();",
                  "if (pm.request.url.toString().includes('admin')) {",
                  "    pm.environment.set('admin_token', json.accessToken);",
                  "} else if (pm.request.url.toString().includes('owner')) {",
                  "    pm.environment.set('owner_token', json.accessToken);",
                  "} else {",
                  "    pm.environment.set('member_token', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@familyconnect.com\",\n    \"password\": \"Admin@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "US-02: Login - Wrong password (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Error message does NOT reveal which field is wrong', function() {",
                  "    const json = pm.response.json();",
                  "    const msg = json.message.toLowerCase();",
                  "    pm.expect(msg).to.include('email');",
                  "    pm.expect(msg).to.include('mật khẩu');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@familyconnect.com\",\n    \"password\": \"WrongPass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "US-05: RBAC - Member cannot delete user (Authorization)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', function() {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users/user-blocked-E",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "user-blocked-E"]
            }
          }
        },
        {
          "name": "US-05: RBAC - Member cannot access other family data (Authorization)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', function() {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Error message mentions no permission', function() {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message.toLowerCase()).to.include('không có quyền');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/families/family-B/tree",
              "host": ["{{base_url}}"],
              "path": ["families", "family-B", "tree"]
            }
          }
        }
      ]
    },
