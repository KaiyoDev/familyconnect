                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error mentions cycle/loop', function() {",
                  "    const json = pm.response.json();",
                  "    const msg = json.message.toLowerCase();",
                  "    pm.expect(msg).to.satisfy((m) => m.includes('vòng lặp') || m.includes('cycle') || m.includes('mâu thuẫn thế hệ'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
